# Mattermost instance base URL
MATTERMOST_URL=https://mattermost.yourdomain.com

# Mattermost authentication token (Bot or Personal Access Token)
MATTERMOST_TOKEN=your_secret_token

# Mattermost channel ID to monitor
MATTERMOST_CHANNEL_ID=your_channel_id

# Optional: Mattermost team name for building permalinks
MATTERMOST_TEAM=your_team

# Titles of status batch alerts to exclude from the report (comma-separated, case-insensitive)
EXCLUDED_ALERT_TITLES=Batche(s)

# Timezone for report formatting (default: Europe/Paris, falls back to UTC if unavailable)
APP_TIMEZONE=Europe/Paris

# Maximum number of detailed alerts displayed in the final section to keep the DOM responsive
# Set to 0 or negative to disable the limit
MAX_DETAILED_ALERTS=200

# Confluence tracking and action plan (Review Meeting)
CONFLUENCE_URL=https://confluence.yourdomain.com
CONFLUENCE_TOKEN=your_personal_confluence_token
CONFLUENCE_PAGE_ID=123456789
CONFLUENCE_ARCHIVE_PAGE_ID=123456780
CONFLUENCE_STATS_PAGE_ID=123456781

# Optional: disable Confluence synchronization (true/false, default: false)
CONFLUENCE_DISABLED=false

# Enable Confluence tracking mode (true/false, default: false, can be overridden via CLI --confluence-tracking)
CONFLUENCE_TRACKING=false
# Backward compatible alias:
SUIVI_CONFLUENCE=false
