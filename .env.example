# URL de base de l'instance Mattermost
MATTERMOST_URL=https://mattermost.votredomaine.com

# Token d'authentification Mattermost (Bot ou Token d'accès personnel)
MATTERMOST_TOKEN=votre_token_secret

# Identifiant du canal Mattermost à surveiller
MATTERMOST_CHANNEL_ID=id_du_canal_a_surveiller

# Nom de l'équipe (Team) Mattermost (optionnel, recommandé pour des permaliens exacts)
MATTERMOST_TEAM=

# Titres d'alertes à exclure du rapport, séparés par des virgules (optionnel, défaut : Batche(s))
EXCLUDED_ALERT_TITLES=Batche(s)

# Fuseau horaire pour l'affichage des dates et de la frise (défaut : Europe/Paris)
APP_TIMEZONE=Europe/Paris

# Nombre maximal d'alertes dans la section détaillée pour optimiser le rendu navigateur (défaut : 200, 0 = illimité)
MAX_DETAILED_ALERTS=200

# Suivi et plan d'action d'alerting sur Confluence (Point de suivi)
CONFLUENCE_URL=https://confluence.votredomaine.com
CONFLUENCE_TOKEN=votre_token_personnel_confluence
CONFLUENCE_PAGE_ID=123456789
CONFLUENCE_ARCHIVE_PAGE_ID=123456780
CONFLUENCE_STATS_PAGE_ID=123456781
# Optionnel : désactiver la synchronisation Confluence (true/false, par défaut : false)
CONFLUENCE_DISABLED=false
# Activer le suivi Confluence (true/false, par défaut : false, surchargeable via CLI --suivi-confluence)
SUIVI_CONFLUENCE=false
